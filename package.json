{
  "name": "portfolio-web-daniel",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio de Daniel Salado: web estática generada desde MongoDB local",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
